  "checklist": {
    "purpose": "判斷個股細微波下跌是否走完（片中用畫圖答留言）",
    "steps": [
      "先定調整形：高檔下來常見 a-b-c；標準示範＝3-3-5（a三段、b三段、c五段下）",
      "認 c 波五段：標 ①②③④⑤；⑤＝最後一大段下跌",
      "再拆細微波：⑤ 內再標 1-2-3-4-5；五之五末端走完才叫細微波跌完味道完整",
      "軌道／有效重點：同軌往下推動才有效；破一點、軌道太平≠有效五段",
      "第五波進行中：先忍、不必殺低；可容忍再破一點；差一天＝一根跌停也認（南亞科）",
      "走完後：反彈回先前第④波／前結構區再評估調節",
      "空手另條件：低本益比／錯殺；約>20倍先不考慮（相對台積估值口播）",
      "另一種相對低：上漲五波後回測次級④波水平支撐（威剛／倚強）—仍非話筒買訊"
    ],
    "endure_vs_observe_zh": {
      "endure": "大盤／個股仍在第五段細微波中→忍住勿殺低",
      "observe": "五之五末端結構完整（如南亞科當日放大）→相對低可觀察；仍可能再破一點",
      "trapped": "被套→等反彈回前結構區再評估",
      "empty_hand": "空手更謹慎；優先低本益比錯殺"
    },
