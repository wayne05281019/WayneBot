PORT=10000
WAYNE_MODE=web
WAYNE_DB_PATH=data/wayne_market.db
WAYNE_CACHE_DIR=waynebot_cache
WAYNE_CHARTS_DIR=data/charts
# Telegram token 當密碼：只放 Render 環境變數，不要貼聊天、不要進 git。
# GitHub Actions 不准注入 TELEGRAM_*。Cursor My Secrets 給新代理人寄訊，同樣不要貼出來。
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE
# 哥哥的 Telegram uid。可寫在 TELEGRAM_CHAT_ID 逗號後面，或獨立這行。真人 id 不准進 git。
WAYNE_FAMILY_CHAT_IDS=
TG_BOT_TOKEN=
TG_CHAT_ID=
GITHUB_RELEASE_URL=https://github.com/wayne05281019/WayneBot/releases/download/v1.0-data/waynebot_production_complete.zip
ENABLE_DAILY_SCHEDULER=true
# Cursor／筆電除錯時設 1，避免跟 Render 搶同一個 Telegram Bot。
# Cursor Cloud（CURSOR_AGENT=1）即使沒設這行也不會輪詢，只准 sendMessage。
WAYNE_SKIP_POLLING=
# 同學會留言 JSON（樓中樓）用。只放 Render 環境變數，不要貼帳密、不要進 git。
# 空著＝只抓公開主文。從已登入分頁的 Network → Comments → Authorization 複製。
CMONEY_AUTH_TOKEN=
# 話筒語音聽寫（飆大按麥克風）。只放 Render 環境變數，不要進 git。
# GROQ_API_KEY=
# OPENAI_API_KEY=
# WAYNE_STT_KEY=
